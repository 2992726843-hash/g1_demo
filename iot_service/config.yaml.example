# Home Assistant 接入配置
ha_url: "http://localhost:8123"
token: "your_home_assistant_token_here"

# 本服务监听地址
server_host: "0.0.0.0"
server_port: 5001

# HTTP 超时（秒）
timeout: 5

# 是否启用 Mock 模式（无需真实 HA 即可调试）
# true  -> 使用内置模拟后端，并开放 /mock/* 管理接口
# false -> 使用真实 Home Assistant
mock: true

# 日志级别: DEBUG / INFO / WARNING / ERROR
log_level: "INFO"
